rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to submit a consultation request
    match /consultations/{consultationId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.fullName is string
                    && request.resource.data.requiredServices is string;
      // Allow reading if authenticated user created it or owner or authorized admin
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        request.auth.token.email == 'sabrinsaka001@gmail.com'
      );
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'sabrinsaka001@gmail.com'
      );
    }

    // Invoices and Client Enrollment Agreements
    match /invoices/{invoiceId} {
      allow create, update, delete: if request.auth != null && (
        request.auth.token.email == 'sabrinsaka001@gmail.com' ||
        request.auth.token.email == 'amit@leadnestit.com' ||
        request.auth.token.email == 'ibrahim@leadnestit.com'
      );
      allow read: if request.auth != null && (
        resource.data.clientEmail == request.auth.token.email ||
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'sabrinsaka001@gmail.com' ||
        request.auth.token.email == 'amit@leadnestit.com' ||
        request.auth.token.email == 'ibrahim@leadnestit.com'
      );
    }

    // Default catch-all for user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
